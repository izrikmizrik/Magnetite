<?xml version="1.0" encoding="utf-8"?>
<!-- Magnetite Android, stage 0: the stock NativeActivity loads libmagnetite_android.so
     (crates/magnetite-android). The Java here is the app's own: the Storage Access Framework
     provider that shows the game folder to the system Files app, and the transparent activity
     that answers the game's file picker. The in-game launcher's activity comes with a later
     stage (docs/unification/plan.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mods record the microphone (ClientMicrophoneClientHost); the game asks at run time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Turning the phone turns the view (horizon_client::phone); a phone without one plays on. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <application android:label="Magnetite" android:appCategory="game" android:hasCode="true" android:extractNativeLibs="true" android:usesCleartextTraffic="false">
        <activity android:name="android.app.NativeActivity" android:exported="true" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden|keyboard|density|screenLayout" android:theme="@style/MagnetiteGameTheme">
            <meta-data android:name="android.app.lib_name" android:value="magnetite_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The file picker's activity: transparent, no title, over the game; not exported, so
             only this app starts it (crates/magnetite-android/src/pick.rs). -->
        <activity android:name="dev.magnetite.PickFileActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:configChanges="orientation|screenSize|keyboardHidden|keyboard|density|screenLayout" />
        <provider android:name="dev.magnetite.MagnetiteDocumentsProvider" android:authorities="${applicationId}.documents" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
